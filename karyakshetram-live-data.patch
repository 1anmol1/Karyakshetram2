+// Live data API: feasibility + sync status (Trust Center), manual refresh, registry upload, what-if closures.
+import { Router } from 'express';
+import { z } from 'zod';
+import { optionalAuth, requireAuth, validate } from '../middleware/index.js';
+import { asyncH, bad, notFound } from '../utils/index.js';
+import { Poi, LiveSync } from '../models/index.js';
+import { catByKey, CATEGORIES } from '../data/categories.js';
+import { LIVE, LIVE_KEYS, feasibilityOf } from '../data/liveSources.js';
+import { syncCategory, syncAll, setCompetitorStatus } from '../services/liveData.js';
+
+const r = Router();
+r.use(optionalAuth);
+
+async function statusOf(key) {
+  const spec = LIVE[key];
+  const [last, lastOk, bySource, closed] = await Promise.all([
+    LiveSync.findOne({ category: key }).sort({ createdAt: -1 }).lean(),
+    LiveSync.findOne({ category: key, ok: true }).sort({ createdAt: -1 }).lean(),
+    Poi.aggregate([{ $match: { category: key, status: { $ne: 'closed' } } }, { $group: { _id: '$source', n: { $sum: 1 } } }]),
+    Poi.aggregate([{ $match: { category: key, status: 'closed' } }, { $group: { _id: '$closedReason', n: { $sum: 1 } } }]),
+  ]);
+  const src = Object.fromEntries(bySource.map((x) => [x._id || 'simulated', x.n]));
+  const live = (src.osm || 0) + (src.registry || 0) + (src['osm+registry'] || 0);
+  return {
+    key, name: catByKey[key]?.name, icon: catByKey[key]?.icon, live: !!spec,
+    feasibility: spec ? feasibilityOf(key) : null, parts: spec?.parts || null, note: spec?.note || null,
+    sources: spec ? [{ name: 'OpenStreetMap (Overpass API)', kind: 'map', refresh: `every ${process.env.LIVE_REFRESH_HOURS || 12} h` }, { ...spec.registry, kind: 'registry' }] : [],
+    mode: live > 0 ? 'live' : 'simulated',
+    counts: { ...src, live, closed: Object.fromEntries(closed.map((x) => [x._id || 'UNKNOWN', x.n])) },
+    lastSync: last ? { at: last.createdAt, ok: last.ok, error: last.error, added: last.added, closed: last.closed, reopened: last.reopened, nameCoverage: last.nameCoverage } : null,
+    lastSuccessAt: lastOk?.createdAt || null,
+  };
+}
+
+r.get('/status', asyncH(async (req, res) => {
+  const keys = req.query.category ? [String(req.query.category)] : LIVE_KEYS;
+  const out = await Promise.all(keys.filter((k) => catByKey[k]).map(statusOf));
+  res.json({ categories: out, liveKeys: LIVE_KEYS, simulatedKeys: CATEGORIES.map((c) => c.key).filter((k) => !LIVE[k]) });
+}));
+
+r.post('/refresh', requireAuth, asyncH(async (req, res) => {
+  const k = req.query.category ? String(req.query.category) : null;
+  if (k && !LIVE[k]) throw bad(`${k} has no live source yet`, 'category');
+  const results = k ? [await syncCategory(k)] : await syncAll();
+  res.json({ results });
+}));
+
+const regSchema = z.object({ rows: z.array(z.object({ name: z.string().min(1), lat: z.coerce.number(), lon: z.coerce.number(), regNo: z.string().optional(), status: z.string().optional() })).min(1).max(5000) });
+r.post('/registry/:category', requireAuth, validate(regSchema), asyncH(async (req, res) => {
+  const k = req.params.category;
+  if (!LIVE[k]) throw bad(`${k} has no live source yet`, 'category');
+  res.json({ result: await syncCategory(k, { extraRegistry: req.body.rows }) });
+}));
+
+// What-if: "this competitor does not exist" → every score, hexagon and recommendation recomputes
+const stSchema = z.object({ status: z.enum(['open', 'closed']), reason: z.enum(['WHAT_IF', 'USER_REPORTED']).default('WHAT_IF') });
+r.post('/competitors/:id/status', requireAuth, validate(stSchema), asyncH(async (req, res) => {
+  const p = await setCompetitorStatus(req.params.id, req.body.status, req.body.reason);
+  if (!p) throw notFound('Competitor not found');
+  res.json({ competitor: { id: String(p._id), name: p.name, category: p.category, status: p.status, closedReason: p.closedReason } });
+}));
+
+r.get('/competitors/closed', asyncH(async (req, res) => {
+  const q = { status: 'closed', ...(req.query.category ? { category: String(req.query.category) } : {}) };
+  const list = await Poi.find(q).sort({ statusChangedAt: -1 }).limit(100).lean();
+  res.json({ competitors: list.map((p) => ({ id: String(p._id), name: p.name, category: p.category, locality: p.locality, closedReason: p.closedReason, at: p.statusChangedAt, source: p.source })) });
+}));
+
+export default r;
