{
  "name": "karyakshetram-server",
  "version": "1.0.0",
  "description": "Karyakshetram API gateway (Express + MongoDB). ML and LLM are pluggable adapters.",
  "type": "module",
  "main": "src/index.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "seed": "node src/scripts/seed.js",
    "smoke": "node src/scripts/smoke.js"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "compression": "1.7.4",
    "cors": "2.8.5",
    "csv-parse": "5.5.6",
    "dotenv": "16.4.5",
    "express": "4.21.1",
    "express-rate-limit": "7.4.1",
    "h3-js": "4.1.0",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.8.1",
    "morgan": "1.10.0",
    "multer": "1.4.5-lts.1",
    "zod": "3.23.8"
  },
  "devDependencies": { "nodemon": "3.1.7" }
