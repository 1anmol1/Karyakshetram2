# Karyakshetram API (Express + MongoDB)
PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/karyakshetram
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES=7d
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MIN=300

# ---- ML service (FastAPI service in /backend).
ML_SERVICE_URL=http://127.0.0.1:8000
ML_INTERNAL_KEY=dev-ml-key-change-in-prod
ML_TIMEOUT_MS=15000
MODEL_VERSION=rf-300-v1.0.0

# ---- Optional LLM narrative endpoint (template narratives are used when empty)
LLM_URL=
LLM_API_KEY=

# ---- Live competitor data (OpenStreetMap Overpass + official registries)
# Live categories: grocery, pharmacy, qsr, cafe, fuel, bank, ev, restaurant, bakery, gym. Others stay simulated.
LIVE_DATA=on
LIVE_REFRESH_HOURS=12
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
# Google Places API (New) – adds near-real-time businessStatus (closed permanently/temporarily). Paid per call.
GOOGLE_PLACES_KEY=
GOOGLE_PLACES_TILES=3
# Open Charge Map (EV)
# OCM_API_KEY=
# Platform feeds (Swiggy/Zomato partner exports, brand locators…) – JSON map category → URL
# PLATFORM_FEED_URLS={"restaurant":"https://…/restaurants.json"}
# PLATFORM_FEED_TOKEN=
