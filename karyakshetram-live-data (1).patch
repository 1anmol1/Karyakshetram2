+/**
+ * LIVE DATA SOURCES — categories whose competitor layer comes from real, frequently-changing data
+ * instead of the seeded simulator.
+ *
+ *  1. OpenStreetMap via the Overpass API (free, no key, edited daily by the community).
+ *  2. Official registries for businesses that are NOT on the map (FSSAI, FDA drug licences, RBI branch
+ *     master, oil-company outlet lists, EV operator lists). Rows go in server/data/registry/<key>.csv
+ *     or are POSTed to /api/live/registry/:category. A registry row with status=closed/cancelled
+ *     removes the matching map POI.
+ *
+ * `feasibility` = how much of the real market for this category we can actually see with free,
+ * refreshable data in Pune today (0–100). It is an assessed estimate made up of four parts, shown in the
+ * Trust Center:
+ *   mapCoverage   – share of real outlets likely present on OSM in Pune
+ *   registry      – how usable the official registry is (open, geocodable, current)
+ *   freshness     – how quickly closures/openings show up
+ *   brandSignal   – share of POIs carrying a brand/name usable for brand-class sizing
+ * feasibility = round(0.4·mapCoverage + 0.25·registry + 0.2·freshness + 0.15·brandSignal)
+ * After each live sync the API also reports a measured `nameCoverage` (share of fetched POIs with a name).
+ */
+
+export const PUNE_BBOX = { s: 18.44, w: 73.715, n: 18.695, e: 73.995 };
+
+const HYPER = /d[\s-]?mart|reliance smart|star bazaar|spar|more megastore|big bazaar|metro cash/i;
+const SUPER = /reliance fresh|more|spencer|nature'?s basket|dorabjee|ratnadeep|smart point|fresh/i;
+
+export const LIVE = {
+  grocery: {
+    overpass: ['nwr["shop"="supermarket"]', 'nwr["shop"="grocery"]', 'nwr["shop"="wholesale"]["wholesale"~"food|grocery"]'],
+    registry: { name: 'FSSAI FoSCoS licence register', url: 'https://foscos.fssai.gov.in', field: 'FSSAI licence no.' },
+    parts: { mapCoverage: 55, registry: 70, freshness: 65, brandSignal: 75 },
+    note: 'Chains (D-Mart, Reliance, More, Star Bazaar) are well mapped; small kiranas are under-mapped, so the FSSAI register fills the gap.',
+    brandClass: (t) => (HYPER.test(t.name || t.brand || '') ? 'hypermarket' : SUPER.test(t.name || t.brand || '') || t.shop === 'supermarket' ? 'supermarket' : 'convenience'),
+    area: { hypermarket: 25000, supermarket: 6000, convenience: 1500 },
+  },
+  pharmacy: {
+    overpass: ['nwr["amenity"="pharmacy"]', 'nwr["shop"="chemist"]'],
+    registry: { name: 'FDA Maharashtra retail drug licences', url: 'https://fdamfg.maharashtra.gov.in', field: 'Drug licence no. (Form 20/21)' },
+    parts: { mapCoverage: 65, registry: 85, freshness: 70, brandSignal: 60 },
+    note: 'Every chemist must hold a drug licence, so the FDA list is close to a complete census; OSM covers chains (Apollo, MedPlus, Wellness Forever) well.',
+    brandClass: (t) => (/apollo|medplus|wellness forever|netmeds|truemeds|frank ross|noble/i.test(t.name || t.brand || '') ? 'chain' : 'independent'),
+    area: { chain: 800, independent: 400 },
+  },
+  qsr: {
+    overpass: ['nwr["amenity"="fast_food"]'],
+    registry: { name: 'FSSAI FoSCoS licence register', url: 'https://foscos.fssai.gov.in', field: 'FSSAI licence no.' },
+    parts: { mapCoverage: 70, registry: 70, freshness: 70, brandSignal: 85 },
+    note: 'Global and national QSR brands are almost fully mapped with brand tags; street-food stalls are not.',
+    brandClass: (t) => (t.brand || /mcdonald|kfc|domino|burger king|subway|pizza hut|wow! momo|taco bell/i.test(t.name || '') ? 'chain' : 'independent'),
+    area: { chain: 2200, independent: 900 },
+  },
+  cafe: {
+    overpass: ['nwr["amenity"="cafe"]'],
+    registry: { name: 'FSSAI FoSCoS licence register', url: 'https://foscos.fssai.gov.in', field: 'FSSAI licence no.' },
+    parts: { mapCoverage: 65, registry: 65, freshness: 65, brandSignal: 75 },
+    note: 'Starbucks, Third Wave, Blue Tokai, CCD are mapped; independent cafés open and close fast, so freshness matters.',
+    brandClass: (t) => (t.brand || /starbucks|third wave|blue tokai|cafe coffee day|ccd|costa|barista|tim hortons/i.test(t.name || '') ? 'chain' : 'independent'),
+    area: { chain: 1500, independent: 800 },
+  },
+  fuel: {
+    overpass: ['nwr["amenity"="fuel"]'],
+    registry: { name: 'PESO licences + OMC outlet locators (IOCL/BPCL/HPCL)', url: 'https://peso.gov.in', field: 'PESO licence / outlet code' },
+    parts: { mapCoverage: 90, registry: 85, freshness: 85, brandSignal: 95 },
+    note: 'Fuel stations are large, fixed and licensed; OSM coverage in Pune is near-complete and brands are tagged.',
+    brandClass: (t) => (/indian oil|iocl|bharat|bpcl|hindustan|hpcl|shell|nayara|jio-bp|reliance/i.test(t.brand || t.name || t.operator || '') ? 'omc' : 'other'),
+    area: { omc: 16000, other: 12000 },
+  },
+  bank: {
+    overpass: ['nwr["amenity"="bank"]'],
+    registry: { name: 'RBI Bank Branch master (DBIE / IFSC list)', url: 'https://www.rbi.org.in', field: 'IFSC code' },
+    parts: { mapCoverage: 80, registry: 95, freshness: 85, brandSignal: 90 },
+    note: 'RBI publishes every branch with IFSC; OSM has most branches with operator tags. Highest feasibility category.',
+    brandClass: (t) => (/state bank|sbi|hdfc|icici|axis|kotak|bank of maharashtra|bank of baroda|canara|union bank|pnb/i.test(t.name || t.brand || t.operator || '') ? 'major' : 'other'),
+    area: { major: 2000, other: 1200 },
+  },
+  ev: {
+    overpass: ['nwr["amenity"="charging_station"]'],
+    registry: { name: 'BEE public charger list + operator apps (Tata Power EZ, Statiq, ChargeZone)', url: 'https://beeindia.gov.in', field: 'Operator station ID' },
+    parts: { mapCoverage: 55, registry: 70, freshness: 60, brandSignal: 70 },
