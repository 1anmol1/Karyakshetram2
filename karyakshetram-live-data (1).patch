index 0000000..d32f8be
--- /dev/null
+++ b/server/src/services/liveData.js
@@ -0,0 +1,196 @@
+/**
+ * Live competitor data: OpenStreetMap (Overpass) + official registries → `competitors` collection.
+ *
+ * Each sync, per live category:
+ *   1. fetch every matching OSM node/way/relation inside the Pune & PCMC polygon
+ *   2. merge registry rows (offline businesses not on the map); dedupe within 60 m by name
+ *   3. upsert: new → added (status open); seen again → lastSeen updated / reopened
+ *   4. a POI from a previous live sync that is no longer returned → status closed (NOT_IN_LATEST_OSM)
+ *      a registry row with status closed/cancelled → matching POI closed (REGISTRY_CANCELLED)
+ *   5. simulated POIs of that category are removed once a live sync succeeds
+ *   6. reload the in-memory state → catchments, hexagon scores, recommendations, portfolio all recompute
+ * If Overpass is down, the category keeps its previous data and the failure is logged.
+ */
+import fs from 'fs';
+import path from 'path';
+import { fileURLToPath } from 'url';
+import { parse } from 'csv-parse/sync';
+import { latLngToCell } from 'h3-js';
+import { Poi, LiveSync } from '../models/index.js';
+import { CITY, LOCALITIES } from '../data/city.js';
+import { LIVE, LIVE_KEYS, PUNE_BBOX, feasibilityOf } from '../data/liveSources.js';
+import { insideCity } from '../utils/index.js';
+import { loadState, distKm } from '../ml/placeholder/state.js';
+import { config } from '../config/index.js';
+import { clearAll } from './cache.js';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const REGISTRY_DIR = path.resolve(__dirname, '../../data/registry');
+const ENDPOINTS = (process.env.OVERPASS_URLS || 'https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter').split(',').map((s) => s.trim());
+
+const nearestLocality = (lat, lon) => {
+  let best = null, bd = Infinity;
+  for (const l of LOCALITIES) { const d = distKm(lat, lon, l.lat, l.lon); if (d < bd) { bd = d; best = l.name; } }
+  return best;
+};
+const norm = (s = '') => s.toLowerCase().replace(/[^a-z0-9]/g, '');
+const sameName = (a, b) => { const x = norm(a), y = norm(b); return !!x && !!y && (x.includes(y) || y.includes(x)); };
+
+export function overpassQuery(key) {
+  const { s, w, n, e } = PUNE_BBOX;
+  const parts = LIVE[key].overpass.map((q) => `${q}(${s},${w},${n},${e});`).join('');
+  return `[out:json][timeout:60];(${parts});out center tags;`;
+}
+
+let fetchImpl = (...a) => fetch(...a);
+export const _setFetch = (f) => { fetchImpl = f; }; // tests
+
+async function fetchOverpass(key) {
+  const body = 'data=' + encodeURIComponent(overpassQuery(key));
+  let lastErr;
+  for (const url of ENDPOINTS) {
+    const ctrl = new AbortController(); const t = setTimeout(() => ctrl.abort(), 70000);
+    try {
+      const r = await fetchImpl(url, { method: 'POST', body, signal: ctrl.signal, headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'User-Agent': 'Karyakshetram/1.0 (site selection research)' } });
+      if (!r.ok) throw new Error(`Overpass HTTP ${r.status}`);
+      const j = await r.json();
+      return j.elements || [];
+    } catch (e) { lastErr = e; } finally { clearTimeout(t); }
+  }
+  throw lastErr || new Error('Overpass unreachable');
+}
+
+export function fromOsm(key, el) {
+  const lat = el.lat ?? el.center?.lat, lon = el.lon ?? el.center?.lon;
+  if (lat == null || lon == null || !insideCity(lat, lon, CITY.polygon)) return null;
+  const t = el.tags || {};
+  const spec = LIVE[key];
+  const brandClass = spec.brandClass(t);
+  return {
+    osmId: `${el.type}/${el.id}`, name: t.name || t.brand || t.operator || null, brand: t.brand || t.operator || undefined,
+    category: key, brandClass, areaSqft: spec.area[brandClass] || 1500, lat, lon, source: 'osm',
+  };
+}
+
+export function readRegistry(key) {
+  const f = path.join(REGISTRY_DIR, `${key}.csv`);
+  if (!fs.existsSync(f)) return [];
+  const rows = parse(fs.readFileSync(f), { columns: true, skip_empty_lines: true, trim: true });
+  return normaliseRegistry(key, rows);
+}
+
+/** rows: [{name, lat, lon, regNo?, status?}] – status closed|cancelled|suspended removes the business */
+export function normaliseRegistry(key, rows) {
+  return rows.map((r) => ({
+    name: r.name, lat: Number(r.lat), lon: Number(r.lon), regNo: r.regNo || r.reg_no || r.licence || undefined,
+    closed: /closed|cancel|suspend|revok|surrender/i.test(r.status || ''),
+  })).filter((r) => r.name && Number.isFinite(r.lat) && Number.isFinite(r.lon) && insideCity(r.lat, r.lon, CITY.polygon));
+}
+
+/** Merge OSM + registry into one list of live records and a list of registry closures */
+export function mergeSources(key, osm, registry) {
+  const spec = LIVE[key];
+  const out = osm.map((p) => ({ ...p }));
+  const closures = [];
+  for (const r of registry) {
+    const match = out.find((p) => distKm(p.lat, p.lon, r.lat, r.lon) <= 0.06 && (sameName(p.name, r.name) || !p.name));
+    if (r.closed) { closures.push({ ...r, match }); if (match) match._closed = true; continue; }
+    if (match) { match.source = 'osm+registry'; match.regNo = r.regNo; if (!match.name) match.name = r.name; continue; }
+    const brandClass = spec.brandClass({ name: r.name });
+    out.push({ osmId: `reg/${key}/${r.regNo || norm(r.name) + '@' + r.lat.toFixed(4)}`, name: r.name, category: key, brandClass, areaSqft: spec.area[brandClass] || 1500, lat: r.lat, lon: r.lon, source: 'registry', regNo: r.regNo });
+  }
+  return { records: out.filter((p) => !p._closed), closures };
+}
+
+const running = new Set();
+
+export async function syncCategory(key, { extraRegistry = [], reload = true } = {}) {
+  if (!LIVE[key]) throw new Error(`${key} is not a live category`);
+  if (running.has(key)) return { category: key, skipped: 'already running' };
+  running.add(key);
+  const t0 = Date.now();
+  try {
+    const elements = await fetchOverpass(key);
+    const osm = elements.map((el) => fromOsm(key, el)).filter(Boolean);
+    const registry = [...readRegistry(key), ...normaliseRegistry(key, extraRegistry)];
+    const { records, closures } = mergeSources(key, osm, registry);
+    if (!records.length) throw new Error('Live source returned 0 records; keeping previous data');
+
+    const now = new Date();
+    const existing = await Poi.find({ category: key, source: { $ne: 'simulated' } }).lean();
+    const byId = new Map(existing.map((p) => [p.osmId, p]));
+    const seen = new Set();
+    let added = 0, reopened = 0;
+    const ops = [];
+    for (const p of records) {
+      seen.add(p.osmId);
+      const prev = byId.get(p.osmId);
+      const name = p.name || `${key} outlet`;
+      const set = {
+        name, brand: p.brand, category: key, brandClass: p.brandClass, areaSqft: p.areaSqft, source: p.source, regNo: p.regNo,
+        loc: { type: 'Point', coordinates: [p.lon, p.lat] }, h3: latLngToCell(p.lat, p.lon, 8), locality: nearestLocality(p.lat, p.lon), lastSeen: now,
+      };
+      if (!prev) { added++; Object.assign(set, { status: 'open', firstSeen: now, statusChangedAt: now }); }
+      // closed automatically (vanished/cancelled) but back in the data → reopen; user/what-if closures stay until undone
+      else if (prev.status === 'closed' && ['NOT_IN_LATEST_OSM', 'REGISTRY_CANCELLED'].includes(prev.closedReason)) { reopened++; Object.assign(set, { status: 'open', closedReason: null, statusChangedAt: now }); }
+      ops.push({ updateOne: { filter: { osmId: p.osmId }, update: { $set: set }, upsert: true } });
+    }
+    // vanished from the live sources → no longer exists
+    // only map-only records can "vanish"; registry-backed businesses close via a registry cancellation
+    const vanished = existing.filter((p) => !seen.has(p.osmId) && p.status === 'open' && p.source === 'osm');
+    for (const p of vanished) ops.push({ updateOne: { filter: { _id: p._id }, update: { $set: { status: 'closed', closedReason: 'NOT_IN_LATEST_OSM', statusChangedAt: now } } } });
+    for (const c of closures) if (c.match) ops.push({ updateOne: { filter: { osmId: c.match.osmId }, update: { $set: { status: 'closed', closedReason: 'REGISTRY_CANCELLED', statusChangedAt: now } } } });
+    if (ops.length) await Poi.bulkWrite(ops, { ordered: false });
+    await Poi.deleteMany({ category: key, source: 'simulated' });
+
+    const counts = { osm: 0, registry: 0, both: 0 };
+    for (const p of records) counts[p.source === 'osm+registry' ? 'both' : p.source]++;
+    const nameCoverage = Math.round((osm.filter((p) => p.name).length / Math.max(1, osm.length)) * 100);
+    const log = await LiveSync.create({
+      category: key, ok: true, durationMs: Date.now() - t0, fetched: elements.length, ...counts,
+      open: await Poi.countDocuments({ category: key, status: 'open' }), added, reopened,
+      closed: vanished.length + closures.filter((c) => c.match).length, nameCoverage, feasibility: feasibilityOf(key),
+    });
+    if (reload) await reloadEverywhere();
+    return log.toObject();
+  } catch (e) {
+    await LiveSync.create({ category: key, ok: false, error: String(e.message || e), durationMs: Date.now() - t0, feasibility: feasibilityOf(key) }).catch(() => {});
+    return { category: key, ok: false, error: String(e.message || e) };
+  } finally { running.delete(key); }
+}
+
+export async function syncAll(keys = LIVE_KEYS) {
+  const results = [];
+  for (const k of keys) { results.push(await syncCategory(k, { reload: false })); await new Promise((r) => setTimeout(r, 1500)); } // be polite to Overpass
+  await reloadEverywhere();
+  return results;
+}
+
+/** Reload Node state (clears every score/catchment cache) and tell the Python ML service to reload too */
+export async function reloadEverywhere() {
+  const s = await loadState();
+  clearAll(); // hex layer + recommendation response caches
+  if (config.mlServiceUrl) {
+    fetch(`${config.mlServiceUrl.replace(/\/$/, '')}/ml/reload`, { method: 'POST', headers: { 'X-Internal-Key': config.mlInternalKey } }).catch(() => {});
+  }
+  return s;
+}
+
+/** What-if / user report: mark a competitor as not existing (or restore it) and recompute the whole app */
+export async function setCompetitorStatus(id, status, reason = 'WHAT_IF') {
+  const q = /^[a-f0-9]{24}$/i.test(id) ? { _id: id } : { osmId: id };
+  const p = await Poi.findOneAndUpdate(q, { $set: { status, closedReason: status === 'closed' ? reason : null, statusChangedAt: new Date() } }, { new: true }).lean();
+  if (!p) return null;
+  await reloadEverywhere();
+  return p;
+}
+
+let timer = null;
+export function startScheduler() {
+  const hours = Number(process.env.LIVE_REFRESH_HOURS || 12);
+  if (process.env.LIVE_DATA === 'off' || !hours) return;
+  const run = () => syncAll().then((r) => console.log('[live] sync', r.map((x) => `${x.category}:${x.ok === false ? 'FAIL ' + x.error : x.open + ' open'}`).join(' · '))).catch((e) => console.warn('[live] sync failed', e.message));
+  setTimeout(run, 15000); // first sync shortly after boot
+  timer = setInterval(run, hours * 3600e3);
+  timer.unref?.();
+}
