+                <span className="num" style={{ width: 36, textAlign: 'right' }}>{v}%</span>
+              </div>
+            ))}
+            <span className="s11 faint">Feasibility = 40% map coverage + 25% registry + 20% freshness + 15% brand signal. Assessed estimate for Pune, not a measured census.</span>
+            <span className="s12 muted" style={{ lineHeight: 1.5 }}>{cur.note}</span>
